#!/bin/sh
# rpcd backend for luci-app-tcpdump
# /usr/libexec/rpcd/luci.tcpdump

TCPDUMP_ROOT="/tmp/tcpdump"
TCPDUMP_CAP="${TCPDUMP_ROOT}/cap"
TCPDUMP_FILTER="${TCPDUMP_ROOT}/filter"
PID_FILE="${TCPDUMP_ROOT}/tcpdump.pid"
LOG_FILE="${TCPDUMP_ROOT}/tcpdump.log"
OUT_FILE="${TCPDUMP_ROOT}/tcpdump.out"
SLEEP_FILE="${TCPDUMP_ROOT}/tcpdump.sleep"

ensure_dirs() {
	mkdir -p "$TCPDUMP_CAP" "$TCPDUMP_FILTER"
}

json_output() {
	# Simple JSON output using jsonfilter if available, or printf fallback
	if command -v jsonfilter >/dev/null 2>&1; then
		echo "$1"
	else
		echo "$1"
	fi
}

get_interfaces() {
	local ifaces=""
	local sep=""
	local dev

	if [ -r /proc/net/dev ]; then
		# Skip first two header lines
		awk 'NR>2 {gsub(":",""); print $1}' /proc/net/dev | while read -r dev; do
			[ -n "$dev" ] || continue
			ifaces="${ifaces}${sep}\"${dev}\""
			sep=","
		done
	fi
	# also try ip link
	if command -v ip >/dev/null 2>&1; then
		ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | while read -r dev; do
			dev="${dev%%@*}"
			[ -n "$dev" ] || continue
			ifaces="${ifaces}${sep}\"${dev}\""
			sep=","
		done
	fi
	echo "[$ifaces]"
}

capture_active() {
	if [ -f "$PID_FILE" ]; then
		local pid
		pid=$(head -n1 "$PID_FILE" 2>/dev/null | grep -oE '^[0-9]+$')
		if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
			# verify it is actually tcpdump
			local cmdline
			cmdline=$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')
			case "$cmdline" in
				*tcpdump*)
					echo "$pid"
					return 0
					;;
			esac
		fi
	fi
	return 1
}

capture_log() {
	if [ -f "$LOG_FILE" ]; then
		cat "$LOG_FILE"
	else
		echo -n ""
	fi
}

capture_name() {
	if [ -f "$OUT_FILE" ]; then
		head -n1 "$OUT_FILE" 2>/dev/null
	fi
}

capture_cleanup() {
	rm -f "$PID_FILE" "$LOG_FILE" "$OUT_FILE"
	if [ -f "$SLEEP_FILE" ]; then
		local spid
		spid=$(head -n1 "$SLEEP_FILE" 2>/dev/null | grep -oE '^[0-9]+$')
		if [ -n "$spid" ] && [ -d "/proc/$spid" ]; then
			kill -15 "$spid" 2>/dev/null
		fi
		rm -f "$SLEEP_FILE"
	fi
}

human_size() {
	# not needed in backend (size in bytes returned)
	echo "$1"
}

list_entries() {
	local entries="["
	local first=1
	local file name size mtime filter_exists

	ensure_dirs

	if [ -d "$TCPDUMP_CAP" ]; then
		for file in "$TCPDUMP_CAP"/*.pcap; do
			[ -e "$file" ] || continue
			name=$(basename "$file" .pcap)
			size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
			mtime=$(stat -c%Y "$file" 2>/dev/null || stat -f%Y "$file" 2>/dev/null || echo 0)
			if [ -f "${TCPDUMP_FILTER}/${name}.filter" ]; then
				filter_exists="true"
			else
				filter_exists="false"
			fi
			if [ $first -eq 0 ]; then
				entries="$entries,"
			fi
			entries="${entries}{\"name\":\"${name}\",\"size\":${size},\"mtime\":${mtime},\"filter\":${filter_exists}}"
			first=0
		done
	fi
	entries="$entries]"
	echo "$entries"
}

escape_json_string() {
	# Escape backslashes, double quotes, control characters for JSON
	local s="$1"
	s="${s//\\/\\\\}"
	s="${s//\"/\\\"}"
	s="${s//$'\n'/\\n}"
	s="${s//$'\r'/\\r}"
	s="${s//$'\t'/\\t}"
	printf '%s' "$s"
}

cmd_status() {
	local active pid cap_name cap_name_esc log_esc msg msg_esc entries
	ensure_dirs

	if pid=$(capture_active); then
		active="true"
		pid_esc="$pid"
		cap_name=$(capture_name)
		cap_name_esc=$(escape_json_string "$cap_name")
		log_text=$(capture_log)
		log_esc=$(escape_json_string "$log_text")
		msg="Capture in progress.."
		msg_esc=$(escape_json_string "$msg")
		entries=$(list_entries)
		printf '{"capture":{"active":true,"pid":%s,"msg":"%s","cap_name":"%s","log":"%s"},"list":{"entries":%s,"update":false}}' \
			"$pid_esc" "$msg_esc" "$cap_name_esc" "$log_esc" "$entries"
	elif [ -f "$PID_FILE" ]; then
		capture_cleanup
		msg="Process seems to be dead, removing pid file!"
		msg_esc=$(escape_json_string "$msg")
		entries=$(list_entries)
		printf '{"capture":{"active":false,"pid":null,"msg":"%s","cap_name":null,"log":""},"list":{"entries":%s,"update":false}}' \
			"$msg_esc" "$entries"
	else
		msg="No capture in progress"
		msg_esc=$(escape_json_string "$msg")
		entries=$(list_entries)
		printf '{"capture":{"active":false,"pid":null,"msg":"%s","cap_name":null,"log":""},"list":{"entries":%s,"update":false}}' \
			"$msg_esc" "$entries"
	fi
}

cmd_start() {
	local ifname="$1" stop_value="$2" stop_unit="$3" filter="$4"
	local ok="true"
	local msg_json="[]"
	local err_msgs=""
	local sep=""

	ensure_dirs

	# param_check
	if [ -z "$ifname" ]; then
		ok="false"
		err_msgs="${err_msgs}${sep}\"Interface name is null or blank.\""
		sep=","
	else
		# check iface
		local found="false"
		if [ "$ifname" = "any" ]; then
			found="true"
		elif [ -d "/sys/class/net/$ifname" ] || [ -L "/sys/class/net/$ifname" ]; then
			found="true"
		else
			# try ip link
			if command -v ip >/dev/null 2>&1; then
				if ip link show "$ifname" >/dev/null 2>&1; then
					found="true"
				fi
			fi
		fi
		if [ "$found" != "true" ]; then
			ok="false"
			err_msgs="${err_msgs}${sep}\"Interface does not exist or is not valid.\""
			sep=","
		fi
	fi

	if ! echo "$stop_value" | grep -qE '^[0-9]+$'; then
		ok="false"
		err_msgs="${err_msgs}${sep}\"Capture length parameter must be a number.\""
		sep=","
	fi

	stop_unit_upper=$(echo "$stop_unit" | tr '[:lower:]' '[:upper:]')
	if [ -z "$stop_unit" ]; then
		ok="false"
		err_msgs="${err_msgs}${sep}\"Capture unit is null or blank.\""
		sep=","
	elif [ "$stop_unit_upper" != "T" ] && [ "$stop_unit_upper" != "P" ]; then
		ok="false"
		err_msgs="${err_msgs}${sep}\"Capture unit must be Time(T) or packet(P).\""
		sep=","
	fi

	msg_json="[$err_msgs]"

	if capture_active >/dev/null; then
		ok="false"
		msg_json='["Previous capture is still ongoing!"]'
	fi

	if [ "$ok" != "true" ]; then
		status_out=$(cmd_status)
		# merge
		printf '{"cmd":{"ok":false,"msg":%s},%s' \
			"$msg_json" "${status_out#\{\"capture\":" | sed 's/^/\"capture\":/; s/}$//}'
		# re-emit simpler:
		# just output combined
		:
	fi

	# Actually start capture
	local prefix pcap_file filter_file
	prefix="capture_$(date +%Y-%m-%d_%H.%M.%S)"
	pcap_file="${TCPDUMP_CAP}/${prefix}.pcap"
	filter_file="${TCPDUMP_FILTER}/${prefix}.filter"

	# write filter
	printf '%s' "$filter" > "$filter_file"
	printf '%s' "$prefix" > "$OUT_FILE"

	local cmd="tcpdump -i '${ifname}' -F '${filter_file}' -w '${pcap_file}'"

	if [ "$stop_value" != "0" ] && [ "$stop_unit_upper" = "P" ]; then
		cmd="${cmd} -c ${stop_value}"
	fi

	# Launch in background, capture pid
	( eval "$cmd" > "$LOG_FILE" 2>&1 ) &
	local bgpid=$!
	echo "$bgpid" > "$PID_FILE"

	# If time-based, schedule kill after N seconds
	if [ "$stop_value" != "0" ] && [ "$stop_unit_upper" = "T" ]; then
		( sleep "$stop_value" ; kill -15 "$bgpid" 2>/dev/null ) >/dev/null 2>&1 &
		local sleeppid=$!
		echo "$sleeppid" > "$SLEEP_FILE"
	fi

	msg_json='["Capture in progress.."]'
	filter_esc=$(escape_json_string "$filter")
	status_out=$(cmd_status)
	# Output cmd + status
	printf '{"cmd":{"ok":true,"msg":%s},"filter":"%s",%s' \
		"$msg_json" "$filter_esc" "${status_out#\{\"capture\":" | sed 's/^/\"capture\":/; s/}$//}'
	# fallback simpler output
}

# Simpler start wrapper: rebuild output
cmd_start_simple() {
	local ifname="$1" stop_value="$2" stop_unit="$3" filter="$4"
	local ok="true"
	local -a msgs

	ensure_dirs

	if capture_active >/dev/null; then
		ok="false"
		msgs=("Previous capture is still ongoing!")
	fi

	if [ "$ok" = "true" ]; then
		if [ -z "$ifname" ]; then
			ok="false"; msgs=("${msgs[@]}" "Interface name is null or blank.")
		else
			local found="false"
			if [ "$ifname" = "any" ]; then found="true"
			elif [ -e "/sys/class/net/$ifname" ]; then found="true"
			elif command -v ip >/dev/null 2>&1 && ip link show "$ifname" >/dev/null 2>&1; then found="true"
			fi
			if [ "$found" != "true" ]; then ok="false"; msgs=("${msgs[@]}" "Interface does not exist or is not valid."); fi
		fi
		if ! echo "$stop_value" | grep -qE '^[0-9]+$'; then
			ok="false"; msgs=("${msgs[@]}" "Capture length parameter must be a number.")
		fi
		local stop_unit_upper
		stop_unit_upper=$(echo "$stop_unit" | tr '[:lower:]' '[:upper:]')
		if [ -z "$stop_unit" ]; then
			ok="false"; msgs=("${msgs[@]}" "Capture unit is null or blank.")
		elif [ "$stop_unit_upper" != "T" ] && [ "$stop_unit_upper" != "P" ]; then
			ok="false"; msgs=("${msgs[@]}" "Capture unit must be Time(T) or packet(P).")
		fi
	fi

	if [ "$ok" != "true" ]; then
		local msg_json="["
		local first=1 m
		for m in "${msgs[@]}"; do
			local e
			e=$(escape_json_string "$m")
			[ $first -eq 0 ] && msg_json="$msg_json,"
			msg_json="${msg_json}\"${e}\""
			first=0
		done
		msg_json="$msg_json]"
		local rest
		rest=$(cmd_status)
		printf '{"cmd":{"ok":false,"msg":%s},%s\n' "$msg_json" "${rest#\{}"
		return
	fi

	# == Start ==
	local prefix pcap_file filter_file
	prefix="capture_$(date +%Y-%m-%d_%H.%M.%S)"
	pcap_file="${TCPDUMP_CAP}/${prefix}.pcap"
	filter_file="${TCPDUMP_FILTER}/${prefix}.filter"

	printf '%s' "$filter" > "$filter_file"
	printf '%s' "$prefix" > "$OUT_FILE"

	local stop_unit_upper
	stop_unit_upper=$(echo "$stop_unit" | tr '[:lower:]' '[:upper:]')
	local tcmd="tcpdump -i \"${ifname}\" -F \"${filter_file}\" -w \"${pcap_file}\""
	if [ "$stop_value" != "0" ] && [ "$stop_unit_upper" = "P" ]; then
		tcmd="${tcmd} -c ${stop_value}"
	fi

	( eval "$tcmd" > "$LOG_FILE" 2>&1 ) &
	local bgpid=$!
	echo "$bgpid" > "$PID_FILE"

	if [ "$stop_value" != "0" ] && [ "$stop_unit_upper" = "T" ]; then
		( sleep "$stop_value" ; kill -15 "$bgpid" 2>/dev/null ) >/dev/null 2>&1 &
		local sleeppid=$!
		echo "$sleeppid" > "$SLEEP_FILE"
	fi

	local filter_esc
	filter_esc=$(escape_json_string "$filter")
	local rest
	rest=$(cmd_status)
	printf '{"cmd":{"ok":true,"msg":["Capture in progress.."]},"filter":"%s",%s\n' "$filter_esc" "${rest#\{}"
}

cmd_stop() {
	ensure_dirs
	local pid
	if pid=$(capture_active); then
		kill -15 "$pid" 2>/dev/null
		capture_cleanup
		local rest
		rest=$(cmd_status)
		printf '{"cmd":{"ok":true,"msg":["Capture has been terminated"]},%s\n' "${rest#\{}"
	else
		capture_cleanup
		local rest
		rest=$(cmd_status)
		printf '{"cmd":{"ok":false,"msg":["There was not active capture!"]},%s\n' "${rest#\{}"
	fi
}

cmd_delete() {
	local name="$1"
	ensure_dirs

	if [ "$name" = "all" ]; then
		if [ -d "$TCPDUMP_CAP" ]; then
			rm -f "$TCPDUMP_CAP"/*.pcap 2>/dev/null
		fi
		if [ -d "$TCPDUMP_FILTER" ]; then
			rm -f "$TCPDUMP_FILTER"/*.filter 2>/dev/null
		fi
	else
		rm -f "${TCPDUMP_CAP}/${name}.pcap" 2>/dev/null
		rm -f "${TCPDUMP_FILTER}/${name}.filter" 2>/dev/null
	fi

	cmd_status
}

cmd_list() {
	ensure_dirs
	local entries
	entries=$(list_entries)
	printf '{"list":{"entries":%s,"update":true}}' "$entries"
}

cmd_get_file() {
	local ftype="$1" fname="$2"
	ensure_dirs

	local file mime b64 filename

	case "$ftype" in
		pcap)
			file="${TCPDUMP_CAP}/${fname}.pcap"
			mime="application/octet-stream"
			filename="${fname}.pcap"
			;;
		filter)
			file="${TCPDUMP_FILTER}/${fname}.filter"
			mime="text/plain"
			filename="${fname}.filter"
			;;
		all)
			file="/tmp/captures-$(date +%Y-%m-%d_%H.%M.%S).tar"
			tar -cf "$file" -C "$TCPDUMP_CAP" . >/dev/null 2>&1
			mime="application/x-tar"
			filename=$(basename "$file")
			;;
		*)
			printf '{"ok":false,"error":"Invalid file type"}'
			return
			;;
	esac

	if [ ! -f "$file" ] || [ ! -r "$file" ]; then
		printf '{"ok":false,"error":"File not found"}'
		[ "$ftype" = "all" ] && rm -f "$file" 2>/dev/null
		return
	fi

	# base64 encode the file content
	if command -v base64 >/dev/null 2>&1; then
		b64=$(base64 "$file" | tr -d '\n')
	elif command -v openssl >/dev/null 2>&1; then
		b64=$(openssl base64 -in "$file" | tr -d '\n')
	else
		printf '{"ok":false,"error":"No base64 encoder available"}'
		[ "$ftype" = "all" ] && rm -f "$file" 2>/dev/null
		return
	fi

	printf '{"ok":true,"filename":"%s","mime":"%s","data":"%s"}' \
		"$filename" "$mime" "$b64"

	# Clean up temp tar file
	[ "$ftype" = "all" ] && rm -f "$file" 2>/dev/null
}

# ====================
# rpcd entry point
# ====================
case "$1" in
	list)
		# rpcd expects JSON signature of methods on stdout
		cat <<'EOL'
{
	"getStatus": {},
	"startCapture": {
		"ifname": "String",
		"stop_value": "String",
		"stop_unit": "String",
		"filter": "String"
	},
	"stopCapture": {},
	"listFiles": {},
	"deleteFile": { "name": "String" },
	"getInterfaces": {},
	"getFile": { "type": "String", "name": "String" }
}
EOL
		;;
	call)
		method="$2"
		# Read JSON params from stdin
		params=$(cat)

		# Parse params with jq or sed fallback (best-effort)
		parse_json_val() {
			local key="$1"
			# Use jq if installed
			if command -v jq >/dev/null 2>&1; then
				echo "$params" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null
			else
				# naive: try extract "key":"value" or "key":number
				echo "$params" | sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n1
				# fallback: number/bool without quotes
				local nv
				nv=$(echo "$params" | sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\([0-9a-zA-Z._-]*\).*/\1/p" | head -n1)
				[ -n "$nv" ] && echo "$nv"
			fi
		}

		ensure_dirs

		case "$method" in
			getStatus)
				cmd_status
				;;
			startCapture)
				ifname=$(parse_json_val ifname)
				stop_value=$(parse_json_val stop_value)
				stop_unit=$(parse_json_val stop_unit)
				filter=$(parse_json_val filter)
				# filter may contain spaces etc; jq handles correctly above
				# re-extract with jq for filter
				if command -v jq >/dev/null 2>&1; then
					filter=$(echo "$params" | jq -r '.filter // ""' 2>/dev/null)
					ifname=$(echo "$params" | jq -r '.ifname // ""' 2>/dev/null)
					stop_value=$(echo "$params" | jq -r '.stop_value // "0"' 2>/dev/null)
					stop_unit=$(echo "$params" | jq -r '.stop_unit // "T"' 2>/dev/null)
				fi
				cmd_start_simple "$ifname" "$stop_value" "$stop_unit" "$filter"
				;;
			stopCapture)
				cmd_stop
				;;
			listFiles)
				cmd_list
				;;
			deleteFile)
				if command -v jq >/dev/null 2>&1; then
					name=$(echo "$params" | jq -r '.name // ""' 2>/dev/null)
				else
					name=$(parse_json_val name)
				fi
				cmd_delete "$name"
				;;
			getInterfaces)
			ifaces=$(get_interfaces)
			printf '{"interfaces":%s}' "$ifaces"
			;;
		getFile)
			if command -v jq >/dev/null 2>&1; then
				ftype=$(echo "$params" | jq -r '.type // ""' 2>/dev/null)
				fname=$(echo "$params" | jq -r '.name // ""' 2>/dev/null)
			else
				ftype=$(parse_json_val type)
				fname=$(parse_json_val name)
			fi
			cmd_get_file "$ftype" "$fname"
			;;
		*)
			echo '{"error":"Unknown method"}'
		esac
		;;
	*)
		echo "Usage: $0 {list|call} [method]" >&2
		exit 1
		;;
esac
