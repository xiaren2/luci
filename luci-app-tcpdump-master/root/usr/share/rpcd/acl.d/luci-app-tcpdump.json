{
	"luci-app-tcpdump": {
		"description": "Grant access to LuCI app tcpdump",
		"read": {
			"ubus": {
				"luci-rpc": [ "*" ],
				"network.interface": [ "dump" ],
				"luci.tcpdump": [
					"getStatus",
					"listFiles",
					"getInterfaces",
					"getFile"
				]
			},
			"file": {
				"/tmp/tcpdump": [ "list", "read" ],
				"/tmp/tcpdump/cap": [ "list", "read" ],
				"/tmp/tcpdump/filter": [ "list", "read" ]
			},
			"uci": [ ]
		},
		"write": {
			"ubus": {
				"luci.tcpdump": [
					"startCapture",
					"stopCapture",
					"deleteFile",
					"getStatus",
					"listFiles",
					"getInterfaces",
					"getFile"
				]
			},
			"file": {
				"/tmp/tcpdump": [ "list", "read", "write", "remove" ],
				"/tmp/tcpdump/cap": [ "list", "read", "write", "remove" ],
				"/tmp/tcpdump/filter": [ "list", "read", "write", "remove" ]
			},
			"uci": [ ]
		}
	}
}
